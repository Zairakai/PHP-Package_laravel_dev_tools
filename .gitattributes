# Default: treat everything as text and normalize the line endings to LF
* text=auto eol=lf

# Markdown files: readable diffs
*.md diff=markdown

# PHP files: syntax-aware diffs
*.php diff=php

# Binary files (SVG is text: it keeps its diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Left out of the archive of the package (git archive)
#
# Not what the package reads from vendor/: the setup copies .editorconfig, and the pipeline templates run the scripts
# of .gitlab/scripts. A test lists the paths that the code reads, and checks that none is left out.

# Folders
/assets export-ignore
/docs export-ignore
/tests export-ignore

# Files
/.dependency-update.json export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.gitlab-ci.yml export-ignore
/.markdownlint.json export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md export-ignore
/phpinsights.php export-ignore
/phpstan.neon export-ignore
/pint.json export-ignore
/phpunit.xml export-ignore
/rector.php export-ignore
