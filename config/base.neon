# Base PHPStan configuration - SHARED RULES ONLY
# Common rules for both package dev and Laravel projects
#
# The rules come from stanislas-poisson/php-dev-tools (level max, strict rules, PHPUnit rules, the checks, the report
# of the ignores that no longer match). This file only holds what is specific to Laravel.

includes:
  - %rootDir%/../../stanislas-poisson/php-dev-tools/config/phpstan.neon

parameters:
  parallel:
    maximumNumberOfProcesses: 4

  checkDynamicProperties: false
  treatPhpDocTypesAsCertain: false

  # The ignores below are shared by every project and do not match in all of them: they are not reported
  # (reportUnmatched: false). php-dev-tools reports the ignores of a project that no longer match.
  ignoreErrors:
    -
      identifier: missingType.iterableValue
      reportUnmatched: false

    # Laravel patterns
    -
      message: '#Access to an undefined property [a-zA-Z0-9_\\]+::\$[a-zA-Z0-9_]+\.#'
      reportUnmatched: false
    -
      message: '#Call to an undefined method [a-zA-Z0-9_\\]+::[a-zA-Z0-9_]+\(\)\.#'
      reportUnmatched: false
