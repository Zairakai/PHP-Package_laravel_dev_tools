# PHPStan configuration of this package: the thin file that the editor and the CI read.
# The rules are in config/phpstan.neon, which extends the ones of php-dev-tools.

includes:
  - config/package.neon

parameters:
  paths:
    - src

  tmpDir: build/phpstan

  # Strict rules of php-dev-tools that the code of this package does not follow yet. TEMPORARY: reduce this list.
  ignoreErrors:
    -
      identifier: if.condNotBoolean
    -
      identifier: booleanNot.exprNotBoolean
    -
      identifier: arrayFilter.strict
    -
      identifier: plus.leftNonNumeric
