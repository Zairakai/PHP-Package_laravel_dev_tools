# PHPStan configuration for PACKAGE DEVELOPMENT
# This file is used locally and in CI/CD for analyzing the package itself
# Add to .gitignore if you want devs to customize locally

includes:
  - config/package.neon

parameters:
  paths:
    - src

  tmpDir: build/phpstan

  # Strict rules of php-dev-tools that the code of this package does not follow yet. TEMPORARY: reduce this list.
  ignoreErrors:
    -
      identifier: ternary.shortNotAllowed
    -
      identifier: if.condNotBoolean
    -
      identifier: booleanNot.exprNotBoolean
    -
      identifier: arrayFilter.strict
    -
      identifier: plus.leftNonNumeric
    -
      identifier: empty.notAllowed
